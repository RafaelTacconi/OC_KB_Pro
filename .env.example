# Copy this file to `.env` and fill in real values at configuration time.
# `.env` is git-ignored; never commit real credentials.
# See SPEC.md §14 for the full contract.

# Base URL of the OpenAI-compatible endpoint.
OPENAI_BASE_URL=

# API key for the endpoint above.
OPENAI_API_KEY=

# Date the API key expires, as YYYY-MM-DD (e.g. 2026-12-31).
# Entered manually by whoever configures the deployment; there is no way to
# read this from the provider. Leave blank if unknown — the app will run
# normally and simply will not be able to warn before expiry.
OPENAI_API_KEY_EXPIRES_ON=

# Model slugs exactly as the endpoint expects them, one per selectable model.
# Leave a slug blank to hide that model from the picker.
OPENAI_MODEL_FAST=
OPENAI_MODEL_STANDARD=
OPENAI_MODEL_REASONING=

# --- Staging service API (SPEC.md §20.9-§20.13) ---------------------------
# A SINGLE static shared secret for the staging API. This is NOT the
# production auth model (no per-caller identity, no revocation, no audit);
# §17 F10 and OPEN-13/OPEN-14 supersede it. Never commit a real value.
KB_API_KEY=

# Bind host for the API. MUST stay 127.0.0.1 in staging: the API refuses to
# start on anything else (SPEC §20.10), because loopback-only binding is what
# makes it unreachable from the network while OPEN-13/OPEN-14 are unresolved.
KB_API_HOST=127.0.0.1

# Bind port for the API.
KB_API_PORT=8000